{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DSH Native Pet bridge message",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sourceId",
        "sourceLabel",
        "seq",
        "sessions"
      ],
      "properties": {
        "type": {
          "const": "snapshot"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!hook:)"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sourceLabel": {
          "type": "string",
          "minLength": 1
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sessionId",
              "turn",
              "phase",
              "activeTools",
              "pendingApprovals",
              "result"
            ],
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1
              },
              "turn": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "phase": {
                "enum": [
                  "idle",
                  "running",
                  "thinking",
                  "working",
                  "waiting",
                  "completed",
                  "error",
                  "stopped"
                ]
              },
              "activeTools": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "pendingApprovals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "result": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "outcome"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "outcome": {
                        "enum": [
                          "completed",
                          "error",
                          "aborted",
                          "blocked",
                          "max-tokens",
                          "other"
                        ]
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sourceId",
        "seq"
      ],
      "properties": {
        "type": {
          "const": "heartbeat"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!hook:)"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "provider",
        "sessionId",
        "turnId",
        "eventId",
        "kind",
        "occurredAt",
        "toolId"
      ],
      "properties": {
        "type": {
          "const": "activity"
        },
        "provider": {
          "enum": [
            "codex",
            "claudeCode"
          ]
        },
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "eventId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "sessionStarted",
            "turnStarted",
            "toolStarted",
            "toolFinished",
            "waiting",
            "running",
            "turnEnded",
            "failed",
            "interrupted",
            "sessionEnded"
          ]
        },
        "occurredAt": {
          "type": "number",
          "minimum": 0
        },
        "toolId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  ]
}
